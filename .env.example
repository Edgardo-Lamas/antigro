# ── Auth (NextAuth v5) ──────────────────────────────
AUTH_SECRET=

# ── Cuenta del panel en modo demo ───────────────────
# Mientras no haya Supabase, el panel entra con estas dos.
#
# 🔴 VACÍAS A PROPÓSITO, y acá empezó el peor problema del proyecto.
# Este archivo tenía un usuario y una clave escritos "de ejemplo". De acá se
# copiaron al valor por defecto de `auth.ts`, y de ahí salió la cuenta de
# administración de PRODUCCIÓN, que el 17/8 abría con la clave que cualquiera
# leía en este repositorio público.
#
# Una clave de ejemplo es una clave. Si están vacías no entra nadie, que es
# lo correcto.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Supabase ────────────────────────────────────────
# Vacías a propósito: sin esto el sistema anda en modo demo. Fase 1.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── NextDNS ─────────────────────────────────────────
# La puerta está hecha. Sin cuenta, la fuente activa es el simulador.
NEXTDNS_API_KEY=
NEXTDNS_PROFILE_ID=

# ── Resend (alertas por correo — fase 3) ────────────
RESEND_API_KEY=

# ── Anthropic (el motor, fase 2 — modelo claude-opus-5) ──
# ⚠ Nombre propio a propósito: si la terminal exporta ANTHROPIC_API_KEY,
#   ésa pisa al .env.local y el proyecto queda sin clave.
ANTIGRO_ANTHROPIC_KEY=

# ── Telegram (canal de demostración — fase 3) ───────
TELEGRAM_BOT_TOKEN=

TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

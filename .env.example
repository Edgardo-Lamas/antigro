# ── Auth (NextAuth v5) ──────────────────────────────
AUTH_SECRET=

# ── Cuenta del panel en modo demo ───────────────────
# Mientras no haya Supabase, el panel entra con estas dos.
ADMIN_EMAIL=demo@antigro.app
ADMIN_PASSWORD=antigro2026

# ── Supabase ────────────────────────────────────────
# Vacías a propósito: sin esto el sistema anda en modo demo. Fase 1.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── NextDNS ─────────────────────────────────────────
# La puerta está hecha. Sin cuenta, la fuente activa es el simulador.
NEXTDNS_API_KEY=
NEXTDNS_PROFILE_ID=

# ── Resend (alertas por correo — fase 3) ────────────
RESEND_API_KEY=

# ── Anthropic (el motor, fase 2 — modelo claude-opus-5) ──
# ⚠ Nombre propio a propósito: si la terminal exporta ANTHROPIC_API_KEY,
#   ésa pisa al .env.local y el proyecto queda sin clave.
ANTIGRO_ANTHROPIC_KEY=

# ── Telegram (canal de demostración — fase 3) ───────
TELEGRAM_BOT_TOKEN=

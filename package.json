{
  "name": "antigro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "probar-reglas": "node --experimental-strip-types --no-warnings src/lib/ia/reglas.prueba.ts",
    "probar-sugerencias": "node --experimental-strip-types --no-warnings src/lib/datos/sugerencias.prueba.ts",
    "probar": "npm run probar-reglas && npm run probar-sugerencias && npm run probar-instalacion",
    "probar-instalacion": "node --experimental-strip-types --no-warnings src/lib/instalacion.prueba.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@supabase/supabase-js": "^2.105.1",
    "bcryptjs": "^3.0.3",
    "geist": "^1.7.0",
    "lucide-react": "^1.8.0",
    "next": "14.2.35",
    "next-auth": "^5.0.0-beta.31",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.12.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
